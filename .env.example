# 知脉 · 环境变量模板
#
# 用法：
#   cp .env.example .env
#   把需要的那几行前面的 "# " 去掉，填上真实值，保存
#
# ⚠️ 三条硬规则（违反会让登录按钮一直是灰的，或让配置被判定为非法）：
#
#   1. 不需要的变量请「保持注释状态」，绝不要留成 `KEY=` 这样的空值行。
#      本项目把「已设置但为空」判定为非法配置，且不会回落到官方默认值 ——
#      空串和「未设置」是两种不同结果。
#   2. .env 不要提交进仓库，也不要把值贴进聊天、截图或日志。
#   3. 值不要加引号，不要在行尾写注释。

# ---------- 登录必需（三项）----------
# App ID / App Key：在黑客松项目大厅提交作品后，由页面分配
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=

# 回调地址：必须与你在活动页面登记的 redirect_uri「完全一致」——
# 协议、域名、路径一字不差，尾部斜杠也算。
# 本项目的回调路径固定为 /auth/zhihu/callback
# ZHIHU_OAUTH_REDIRECT_URI=https://你的域名/auth/zhihu/callback

# ---------- 收藏夹功能（可选，缺它不影响登录）----------
# Access Secret：在 https://developer.zhihu.com/ 单独创建
# 登录门禁与收藏夹门禁是分离的：只缺这一项时，登录照常可用。
# ZHIHU_ACCESS_SECRET=

# ---------- 直答拆分引擎（可选，缺它时自动回落本地规则）----------
# 复用上面的 ZHIHU_ACCESS_SECRET，不需要另填凭证。
# ⚠️ 直答 API 目前处于「邀测阶段」，额度需向 openplatform@zhihu.com 申请。
#    额度用尽时服务端返回 429，本项目会自动降级为本地规则拆分，
#    并可用 `知识重构.py --引擎 直答 --严格` 跳过不落盘、等额度恢复后重跑。
# 档位：zhida-fast-1p5（快）/ zhida-thinking-1p5（默认，实测拆分质量最好）/
#      zhida-agent（实测持续 429，且档位语义偏检索问答，不建议）
# ZHIHU_ZHIDA_MODEL=zhida-thinking-1p5
# ZHIHU_ZHIDA_ENABLED=true
# 单次请求超时（毫秒）、最大尝试次数（含 429 退避重试）
# ZHIHU_ZHIDA_TIMEOUT_MS=180000
# ZHIHU_ZHIDA_MAX_ATTEMPTS=3

# ---------- 身份接口契约（不确定就保持注释，会走内置默认值）----------
# 这三项用于「获取当前授权用户身份」。官方未公开完整契约，
# 保持注释即使用默认值；一旦取消注释就必须填对，否则登录会以
# identity_unavailable 失败。
# ZHIHU_OAUTH_PROFILE_URL=
# ZHIHU_OAUTH_PROFILE_AUTH=
# ZHIHU_OAUTH_PROFILE_ID_PATH=

# ---------- 可选：state 联调开关（默认严格校验）----------
# 官方 quickstart 第 2 步与 zhihu2077 实测都表明：回调只带
# authorization_code，不回传 state。保持注释 = 严格拒绝（无 state 一律
# state_missing）。填 cookie_bound = 改用一次性 flow Cookie 关联登录，
# 工作区会如实标注「仅适合临时联调」；只允许填这个值，其他值判非法。
# ZHIHU_OAUTH_STATE_FALLBACK=cookie_bound

# ---------- 可选：重扫用的环境文件路径 ----------
# /api/重扫 会以子进程方式调用 知识重构.py / 处理.py。
# 这两个脚本若需要单独的环境文件，在此填绝对路径。
# KNOWLEDGE_ENV_FILE=
